WEB_BUILD_CONTEXT=/var/www/ettiganibot-dashboard.com/public_html
BOT_DATA_HOST_PATH=/bots/ettiganibot/data
ANNOUNCEMENTS_HOST_PATH=/var/www/ettiganibot-dashboard.com/public_html/app/data/announcements.json
DISCORD_BOT_TOKEN=replace-with-the-bot-token
DISCORD_CLIENT_ID=replace-with-the-discord-application-client-id
DISCORD_CLIENT_SECRET=replace-with-the-discord-application-client-secret
DISCORD_REDIRECT_URI=https://ettiganibot-dashboard.com/api/auth/discord/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
VERIFY_DISCORD_REDIRECT_URI=https://ettiganibot-dashboard.com/api/verify/callback
TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
VERIFY_INTERNAL_SECRET=replace-with-the-same-long-random-secret-in-bot-env
VERIFY_DATABASE_PATH=/app/community-data/verification.sqlite
COMMUNITY_DATA_HOST_PATH=/bots/ettiganibot/community-data
DEV_NOTES_HOST_PATH=/var/www/ettiganibot-dashboard.com/public_html/app/data
ADMIN_IDS=
DEV_NOTES_ENABLED=true
COMMUNITY_ENABLED=true
SITE_MAINTENANCE=false
