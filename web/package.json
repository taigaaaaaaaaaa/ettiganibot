{
  "name": "ettiganibot-ranking-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/generate-command-catalog.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/generate-command-catalog.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{js,css,json}\" \"components/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.mjs\" \"*.{mjs,json,yaml}\" README.md",
    "format:check": "prettier --check \"app/**/*.{js,css,json}\" \"components/**/*.js\" \"lib/**/*.js\" \"scripts/**/*.mjs\" \"*.{mjs,json,yaml}\" README.md",
    "generate:commands": "node scripts/generate-command-catalog.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "acorn": "^8.15.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13"
  }
}
